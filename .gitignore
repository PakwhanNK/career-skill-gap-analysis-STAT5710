data/user_ids.txt
data/user_profiles.csv
notebooks/user_ids.txt
data/processed/ready_analysis/core_user_ids.txt

# Older exploratory runs; final deliverables are in outputs/.
supply_side_outputs/
top_company_prediction/

# Generated row-level/model artifacts. Keep aggregate tables, figures, report, and scripts.
outputs/*.parquet
outputs/models/
outputs/tables/features_*_sample.csv

