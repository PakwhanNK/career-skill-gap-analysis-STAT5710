# Data files: do not commit raw/processed CSVs to the repo.
# Place your CSV files in data/raw/ or data/processed/ locally.
data/raw/*.csv
data/processed/*.csv

# General CSV exclusion (covers any other location)
*.csv

# Raw data files too large for normal GitHub pushes.
data/Revelio Companies_ALL.csv
data/Revelio Education_ALL.csv
data/user_skills.csv
data1.csv
